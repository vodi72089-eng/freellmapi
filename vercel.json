{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build -w client",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://freellmapi-production-68d8.up.railway.app/api/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "https://freellmapi-production-68d8.up.railway.app/v1/:path*"
    }
  ]
}
